user www-data;
worker_processes auto;
pid /run/nginx.pid;
events { worker_connections 1024; }

http {
  access_log /var/log/nginx/access.log;
  error_log /var/log/nginx/error.log;

  server {
    listen ${PROXY_HTTP_PORT};
    server_name ${PROXY_SERVER_NAME} ${MFA_DBO_AUTH_DOMAIN};
    return 301 https://$host:${DBO_HOST_HTTPS_PORT}$request_uri;
  }

  server {
    listen ${PROXY_HTTPS_PORT} ssl;
    server_name ${PROXY_SERVER_NAME};
    ssl_certificate /etc/ssl/certs/banklab-proxy.crt;
    ssl_certificate_key /etc/ssl/private/banklab-proxy.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
      proxy_set_header Host $http_host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Host $http_host;
      proxy_set_header X-Forwarded-Proto https;
      proxy_pass http://${BANK_MFA_DBO_IP}:80;
    }
  }

  server {
    listen ${PROXY_HTTPS_PORT} ssl;
    server_name ${MFA_DBO_AUTH_DOMAIN};
    ssl_certificate /etc/ssl/certs/banklab-proxy.crt;
    ssl_certificate_key /etc/ssl/private/banklab-proxy.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_pass http://${BANK_MFA_DBO_IP}:${MFA_AUTHELIA_PORT};
    }
  }
}
